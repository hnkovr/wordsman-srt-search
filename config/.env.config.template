# Non-secret runtime config for srt-search. Render a flat .env with config/.env-render.sh.
# No secrets needed: all current providers are keyless.
SRT_SEARCH_LOG_LEVEL=${SRT_SEARCH_LOG_LEVEL:-INFO}
SRT_SEARCH_LANGUAGE=${SRT_SEARCH_LANGUAGE:-en}
SRT_SEARCH_PROVIDERS=${SRT_SEARCH_PROVIDERS:-podnapisi}
SRT_SEARCH_DOWNLOAD_DIR=${SRT_SEARCH_DOWNLOAD_DIR:-downloads}
SRT_SEARCH_REQUEST_TIMEOUT=${SRT_SEARCH_REQUEST_TIMEOUT:-30.0}
